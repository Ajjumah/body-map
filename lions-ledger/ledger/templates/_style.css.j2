:root {
  --paper: #f7f3ea;
  --ink: #1c1b19;
  --ink-soft: #4a463f;
  --muted: #77716a;
  --rule: #cfc6b4;
  --rule-strong: #1c1b19;
  --gold: #c9a227;
  --gold-ink: #7a5f0d;
  --gold-wash: #f1e6c2;
  --link: #1c1b19;
  --display: "Playfair Display", "Libre Caslon Display", Georgia, "Times New Roman", serif;
  --text: "Source Serif 4", "Source Serif Pro", "Libre Caslon Text", Georgia, "Times New Roman", serif;
}
@media (prefers-color-scheme: dark) {
  :root {
    --paper: #17150f;
    --ink: #ece5d3;
    --ink-soft: #c9c1ae;
    --muted: #978f7f;
    --rule: #3b372d;
    --rule-strong: #ece5d3;
    --gold: #d4ae3a;
    --gold-ink: #e3c567;
    --gold-wash: #2a2413;
    --link: #ece5d3;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; background: var(--paper); color: var(--ink);
  font-family: var(--text); font-size: 17px; line-height: 1.55;
  font-feature-settings: "kern", "liga", "onum";
}
a { color: var(--link); text-decoration-color: var(--gold); text-underline-offset: 2px; }
a:hover { text-decoration-thickness: 2px; }
.page { max-width: 1180px; margin: 0 auto; padding: 20px 28px 48px; }
.smallcaps, .label { font-variant: small-caps; letter-spacing: .06em; text-transform: lowercase; }

/* Masthead */
.masthead { text-align: center; padding-top: 10px; }
.masthead .ears { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--rule-strong); padding-bottom: 6px; }
.masthead h1 {
  font-family: var(--display); font-weight: 900; font-size: clamp(38px, 8vw, 84px);
  line-height: 1; margin: 14px 0 12px; letter-spacing: .01em; text-transform: uppercase;
}
.dateline {
  border-top: 4px double var(--rule-strong); border-bottom: 4px double var(--rule-strong);
  padding: 6px 0; font-size: 14px; display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
}
.dateline span + span::before { content: "·"; margin-right: 14px; color: var(--gold); font-weight: 700; }
nav.sections { display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 22px; padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: 15px; }
nav.sections a { text-decoration: none; }
nav.sections a:hover { color: var(--gold-ink); }

/* Front page */
.front { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 0; margin-top: 22px; }
.front > .lead { padding-right: 26px; }
.front > aside { padding-left: 26px; border-left: 1px solid var(--rule); }
.kicker { font-size: 13px; color: var(--gold-ink); font-weight: 600; margin-bottom: 4px; }
.lead h2 { font-family: var(--display); font-size: clamp(30px, 4.4vw, 48px); line-height: 1.08; margin: 0 0 10px; font-weight: 800; }
.standfirst { font-style: italic; font-size: 1.12em; color: var(--ink-soft); margin: 0 0 8px; line-height: 1.4; }
.byline { font-size: 13px; color: var(--muted); margin-bottom: 12px; }
.lead .body { column-count: 2; column-gap: 26px; column-rule: 1px solid var(--rule); text-align: justify; hyphens: auto; }
.lead .body > p:first-child::first-letter {
  float: left; font-family: var(--display); font-weight: 900; font-size: 4.1em; line-height: .82;
  padding: 6px 8px 0 0; color: var(--ink);
}
.body p { margin: 0 0 .8em; }
.body ul { margin: 0 0 .8em; padding-left: 1.1em; }
.wim { margin: 10px 0 0; padding: 6px 10px; border-left: 3px solid var(--gold); background: var(--gold-wash); font-size: .95em; break-inside: avoid; }
.wim strong { font-variant: small-caps; letter-spacing: .04em; }

.attention { border: 2px solid var(--gold); border-top-width: 8px; padding: 12px 14px 8px; margin-bottom: 22px; background: color-mix(in srgb, var(--gold-wash) 55%, transparent); }
.attention h3, .diary h3 { font-family: var(--display); font-size: 20px; margin: 0 0 8px; display: flex; align-items: center; gap: 8px; }
.attention h3::before { content: ""; width: 12px; height: 12px; background: var(--gold); display: inline-block; }
.attention ul { list-style: none; margin: 0; padding: 0; }
.attention li { padding: 7px 0; border-top: 1px solid var(--rule); font-size: 15px; line-height: 1.4; }
.attention li:first-child { border-top: 0; }
.due { display: inline-block; font-size: 12px; font-weight: 700; color: var(--gold-ink); margin-right: 4px; white-space: nowrap; }
.due.overdue { color: #b3261e; }
.attention .src, .src { font-size: 12px; color: var(--muted); white-space: nowrap; }
.diary h3 { border-top: 1px solid var(--rule-strong); padding-top: 10px; }
.diary table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.diary td { padding: 5px 0; border-top: 1px solid var(--rule); vertical-align: top; line-height: 1.35; }
.diary td.when { white-space: nowrap; font-weight: 600; padding-right: 12px; width: 1%; }
.diary a { text-decoration: none; }

/* Sections */
section.block { margin-top: 30px; }
h2.section {
  font-family: var(--text); font-weight: 700; font-size: 15px; margin: 0 0 14px; padding: 6px 0 5px;
  border-top: 3px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong);
  font-variant: small-caps; letter-spacing: .12em; text-transform: lowercase;
  display: flex; justify-content: space-between; align-items: baseline;
}
h2.section small { font-weight: 400; letter-spacing: .04em; color: var(--muted); }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 26px; }
.grid > article { padding: 0 18px; border-left: 1px solid var(--rule); }
.grid > article:nth-child(3n+1) { border-left: 0; padding-left: 0; }
.grid > article:nth-child(3n) { padding-right: 0; }
.grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.two > article { border-left: 1px solid var(--rule); padding: 0 22px; }
.grid.two > article:nth-child(odd) { border-left: 0; padding-left: 0; }
.grid.two > article:nth-child(even) { padding-right: 0; }
.grid.solo { grid-template-columns: 1fr; }
.grid.solo .body { column-count: 2; column-gap: 26px; column-rule: 1px solid var(--rule); }
.grid.solo .body > * { break-inside: avoid-column; }
.src a { color: var(--muted); }
article h3 { font-family: var(--display); font-size: 24px; line-height: 1.15; margin: 2px 0 8px; font-weight: 700; }
article .standfirst { font-size: 1em; }
article .body { font-size: 16px; }
.badge { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-ink); border: 1px solid var(--gold); padding: 1px 6px; margin-left: 6px; vertical-align: 2px; }
.sources { margin-top: 10px; font-size: 12px; color: var(--muted); line-height: 1.5; }
.sources a { color: var(--muted); }
.sources b { font-variant: small-caps; letter-spacing: .06em; font-weight: 600; }

.briefly ul { columns: 2; column-gap: 32px; column-rule: 1px solid var(--rule); margin: 0; padding: 0; list-style: none; }
.briefly li { break-inside: avoid; padding: 0 0 10px 16px; position: relative; font-size: 15.5px; line-height: 1.45; }
.briefly li::before { content: "■"; color: var(--gold); position: absolute; left: 0; top: 1px; font-size: 10px; }
.briefly li b { font-weight: 700; }

.notices { color: var(--muted); font-size: 14px; }
.notices h2.section { color: var(--ink-soft); border-top-width: 1px; }
.notices .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px 28px; }
.notices h4 { margin: 0 0 6px; font-variant: small-caps; letter-spacing: .08em; font-size: 14px; color: var(--ink-soft); }
.notices ul { margin: 0; padding: 0; list-style: none; }
.notices li { padding: 4px 0; border-top: 1px dotted var(--rule); line-height: 1.4; }
.notices .memoriam li { font-style: normal; }

footer.colophon { margin-top: 40px; border-top: 4px double var(--rule-strong); padding-top: 8px; font-size: 12px; color: var(--muted); text-align: center; }

@media screen and (max-width: 860px) {
  .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid > article, .grid > article:nth-child(3n+1), .grid > article:nth-child(3n) { border-left: 1px solid var(--rule); padding: 0 16px; }
  .grid > article:nth-child(odd) { border-left: 0; padding-left: 0; }
}
@media screen and (max-width: 700px) {
  body { font-size: 16px; }
  .page { padding: 12px 16px 36px; }
  .masthead .ears { font-size: 11px; }
  .front { grid-template-columns: 1fr; }
  .front > .lead { padding-right: 0; }
  .front > aside { padding-left: 0; border-left: 0; margin-top: 22px; }
  .lead .body { column-count: 1; text-align: left; }
  .grid, .grid.two { grid-template-columns: 1fr; }
  .grid > article, .grid > article:nth-child(n), .grid.two > article:nth-child(n) { border-left: 0; padding: 0 0 18px; border-bottom: 1px solid var(--rule); }
  .briefly ul { columns: 1; }
  .grid.solo .body { column-count: 1; }
  .dateline { font-size: 13px; gap: 8px; }
  .dateline span + span::before { margin-right: 8px; }
}
@page { size: A4; margin: 13mm 12mm 14mm; }
@media print {
  :root { --paper: #fff; --ink: #000; --ink-soft: #222; --muted: #555; --rule: #999; --rule-strong: #000; --gold-wash: #f6efd9; --link: #000; }
  body { font-size: 9.6pt; line-height: 1.4; background: #fff; color: #000; }
  .page { max-width: none; padding: 0; }
  nav.sections { display: none; }
  .masthead h1 { font-size: 44pt; margin: 6pt 0; }
  .lead h2 { font-size: 24pt; }
  .grid.solo { grid-template-columns: 1fr; }
.grid.solo .body { column-count: 2; column-gap: 26px; column-rule: 1px solid var(--rule); }
.grid.solo .body > * { break-inside: avoid-column; }
.src a { color: var(--muted); }
article h3 { font-size: 13.5pt; }
  article .body, .briefly li, .attention li, .diary table { font-size: 9.4pt; }
  .front { grid-template-columns: 2fr 1fr; }
  .grid { grid-template-columns: repeat(3, 1fr); }
  .grid.two { grid-template-columns: repeat(2, 1fr); }
  article, .attention, .diary tr, .briefly li, .notices li { break-inside: avoid; }
  h2.section { break-after: avoid; }
  a { text-decoration: none; }
  .attention { background: #fbf6e6 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
