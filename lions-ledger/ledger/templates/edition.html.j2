<!doctype html>
<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ cfg.title }} · {{ published|date_long }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap">
<style>
{% include "_style.css.j2" %}
</style>
</head>
<body>
{%- macro sources(a) -%}
{% if a.sources %}<div class="sources"><b>Sources:</b>
{% for s in a.sources %}<a href="{{ s.gmail_link }}" target="_blank" rel="noopener" title="{{ s.sender_name }}: {{ s.subject }}">{{ s.label }}, {{ s.received_at|day_month }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
</div>{% endif %}
{%- endmacro -%}
{%- macro wim(a) -%}
{% if a.what_it_means %}<p class="wim"><strong>What it means for you:</strong> {{ a.what_it_means }}</p>{% endif %}
{%- endmacro -%}
{%- macro kicker(a) -%}
{% if a.project_name %}<div class="kicker smallcaps">{{ a.project_name }}{% if a.is_new %}<span class="badge">New on the desk</span>{% endif %}</div>{% endif %}
{%- endmacro -%}
<div class="page">
  <header class="masthead">
    <div class="ears"><span>For {{ cfg.reader_name }}</span><span>{{ source.name }}</span></div>
    <h1>{{ cfg.title }}</h1>
    <div class="dateline">
      <span>{{ cfg.tagline }}</span>
      <span>Edition {{ edition.number }}</span>
      <span>{{ published|date_long }}</span>
    </div>
    <nav class="sections" aria-label="Sections">
      <a href="#front">Front page</a>
      {% if attention %}<a href="#attention">Needs your attention</a>{% endif %}
      {% if diary %}<a href="#diary">Diary</a>{% endif %}
      {% for anchor, label in sections %}<a href="#{{ anchor }}">{{ label }}</a>{% endfor %}
      <a href="index.html">Archive</a>
    </nav>
  </header>

  <main>
  <section class="front" id="front">
    <div class="lead">
      {% if lead %}
      <article>
        {{ kicker(lead) }}
        <h2>{{ lead.headline }}</h2>
        {% if lead.standfirst %}<p class="standfirst">{{ lead.standfirst }}</p>{% endif %}
        {% if lead.byline %}<div class="byline">{{ lead.byline }}</div>{% endif %}
        <div class="body">{{ lead.body_html|safe }}</div>
        {{ wim(lead) }}
        {{ sources(lead) }}
      </article>
      {% else %}
      <article>
        <h2>A quiet week at the club</h2>
        <p class="standfirst">Nothing in the {{ n_emails }} emails for {{ period_start|date_short }} to {{ period_end|date_short }} needed a story.</p>
      </article>
      {% endif %}
    </div>
    <aside>
      {% if attention %}
      <div class="attention" id="attention">
        <h3>Needs Your Attention</h3>
        <ul>
          {% for it in attention %}
          <li>{% if it.due %}<span class="due{% if it.overdue %} overdue{% endif %}">{{ it.due_display }}</span>{% endif %}
            {{ it.summary }} <a class="src" href="{{ it.link }}" target="_blank" rel="noopener">email&nbsp;↗</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if diary %}
      <div class="diary" id="diary">
        <h3>Dates for the Diary</h3>
        <table>
          {% for d in diary %}
          <tr><td class="when">{{ d.date_display }}</td><td><a href="{{ d.link }}" target="_blank" rel="noopener">{{ d.description }}</a></td></tr>
          {% endfor %}
        </table>
      </div>
      {% endif %}
    </aside>
  </section>

  {% if projects %}
  <section class="block" id="projects">
    <h2 class="section">Projects <small>{{ projects|length }} {{ "story" if projects|length == 1 else "stories" }}</small></h2>
    <div class="grid">
      {% for a in projects %}
      <article>
        {{ kicker(a) }}
        <h3>{{ a.headline }}</h3>
        {% if a.standfirst %}<p class="standfirst">{{ a.standfirst }}</p>{% endif %}
        {% if a.byline %}<div class="byline">{{ a.byline }}</div>{% endif %}
        <div class="body">{{ a.body_html|safe }}</div>
        {{ wim(a) }}
        {{ sources(a) }}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if meetings %}
  <section class="block" id="boardroom">
    <h2 class="section">From the Boardroom <small>meetings &amp; minutes</small></h2>
    <div class="grid two{% if meetings|length == 1 %} solo{% endif %}">
      {% for a in meetings %}
      <article>
        <h3>{{ a.headline }}</h3>
        {% if a.standfirst %}<p class="standfirst">{{ a.standfirst }}</p>{% endif %}
        {% if a.byline %}<div class="byline">{{ a.byline }}</div>{% endif %}
        <div class="body">{{ a.body_html|safe }}</div>
        {{ wim(a) }}
        {{ sources(a) }}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if briefly %}
  <section class="block briefly" id="briefly">
    <h2 class="section">Briefly</h2>
    <ul>
      {% for a in briefly %}
      <li>{% if a.headline %}<b>{{ a.headline }}.</b> {% endif %}{{ a.body_html|striptags }}{% if a.is_new %}<span class="badge">New</span>{% endif %}
        <span class="src">{% for s in a.sources %}<a href="{{ s.gmail_link }}" target="_blank" rel="noopener" title="{{ s.subject }}">{{ s.received_at|day_month }}&nbsp;↗</a>{% if not loop.last %}, {% endif %}{% endfor %}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if notice_groups %}
  <section class="block notices" id="notices">
    <h2 class="section">Club Notices</h2>
    <div class="cols">
      {% for title, items in notice_groups %}
      <div{% if title == "In Memoriam" %} class="memoriam"{% endif %}>
        <h4>{{ title }}</h4>
        <ul>
          {% for a in items %}
          <li>{% if a.headline %}<b>{{ a.headline }}</b> {% endif %}{{ a.body_html|striptags }}
            {% for s in a.sources %}<a class="src" href="{{ s.gmail_link }}" target="_blank" rel="noopener">↗</a>{% endfor %}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}
  </main>

  <footer class="colophon">
    {{ cfg.title }} · Edition {{ edition.number }} · covering {{ period_start|date_long }} to {{ period_end|date_long }}
    · written from {{ n_emails }} email{{ "" if n_emails == 1 else "s" }} · set {{ generated.strftime("%H:%M") }} {{ generated|date_short }}
  </footer>
</div>
</body>
</html>
