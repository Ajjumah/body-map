<!doctype html>
<html lang="en-ZA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ cfg.title }} · Archive</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap">
<style>
{% include "_style.css.j2" %}
.archive { list-style: none; padding: 0; margin: 20px 0 0; }
.archive li { display: grid; grid-template-columns: 9em 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--rule); }
.archive .num { font-variant: small-caps; letter-spacing: .06em; color: var(--muted); font-size: 14px; }
.archive a.head { font-family: var(--display); font-size: 22px; font-weight: 700; text-decoration: none; line-height: 1.2; }
.archive .meta { font-size: 13px; color: var(--muted); }
@media screen and (max-width: 600px) { .archive li { grid-template-columns: 1fr; gap: 2px; } }
</style>
</head>
<body>
<div class="page">
  <header class="masthead">
    <h1>{{ cfg.title }}</h1>
    <div class="dateline"><span>The archive</span><span>{{ items|length }} edition{{ "" if items|length == 1 else "s" }}</span></div>
  </header>
  <main>
    {% if items %}
    <ul class="archive">
      {% for it in items %}
      <li>
        <div class="num">Edition {{ it.number }}<br>{{ it.period_end|date_short }}</div>
        <div>
          <a class="head" href="{{ it.file }}">{{ it.lead or ("Edition of " ~ (it.period_end|date_long)) }}</a>
          <div class="meta">{{ it.source }} · {{ it.period_start|date_long }} to {{ it.period_end|date_long }}</div>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p>No editions yet.</p>
    {% endif %}
  </main>
  <footer class="colophon">Updated {{ generated|date_long }}</footer>
</div>
</body>
</html>
